@page "/"
@using ConnectionsManager.Data
@inject ZenQuoteService QuoteService

<PageTitle>ConnectionsManager</PageTitle>
<h1>Welcome!</h1>

@if (quote == null)
{
    <p>Loading your motivational message...</p>
}
else
{
    <div class="quote-box">
        <blockquote>"@quote.q"</blockquote>
        <footer>- @quote.a</footer>
    </div>
}


<!-- Logo Section -->
<div class="logo-section">
    <img src="/logo.png" alt="ConnectionsManager Logo" class="logo-img" />
</div>

<footer class="dashboard-footer">
    ConnectionsManager &copy; Copyright @DateTime.Now.Year
</footer>

@code {
    private Quote? quote;

    protected override async Task OnInitializedAsync()
    {
        quote = await QuoteService.GetDailyQuote();
    }
}