@page "/mynotes"
@attribute [Authorize]

@using Microsoft.EntityFrameworkCore
@using ConnectionsManager.Data
@inject ApplicationDbContext DbContext

<h1>My Notes</h1>

<div class="mb-3">
    <input placeholder="Topic" class="form-control mb-1" @bind="newNote.Topic" />
    <textarea placeholder="Details" class="form-control mb-1" @bind="newNote.Details"></textarea>
    <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" @bind="newNote.IsPrivate" />
        <label class="form-check-label">Private</label>
    </div>
    <button class="btn btn-primary" @onclick="AddNoteAsync">Add Note</button>
</div>

<ul>
    @foreach (var note in notes)
    {
        <li class="mb-2">
            <strong>@note.Topic</strong>: @note.Details
            <button class="btn btn-sm btn-secondary ms-2" @onclick="() => EditNote(note)">Edit</button>
            <button class="btn btn-sm btn-danger ms-1" @onclick="() => DeleteNoteAsync(note)">Delete</button>
        </li>
    }
</ul>

@if (editingNote != null)
{
    <div class="border p-2 mb-2">
        <h5>Edit Note</h5>
        <input class="form-control mb-1" @bind="editingNote.Topic" />
        <textarea class="form-control mb-1" @bind="editingNote.Details"></textarea>
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" @bind="editingNote.IsPrivate" />
            <label class="form-check-label">Private</label>
        </div>
        <button class="btn btn-success me-2" @onclick="UpdateNoteAsync">Save</button>
        <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
    </div>
}

@code {
    private List<Note> notes = new();
    private Note newNote = new Note();
    private Note? editingNote = null;

    protected override async Task OnInitializedAsync()
    {
        notes = await DbContext.Notes.ToListAsync();
    }

    private async Task AddNoteAsync()
    {
        newNote.CreatedAt = DateTime.UtcNow;
        DbContext.Notes.Add(newNote);
        await DbContext.SaveChangesAsync();
        notes.Add(newNote);
        newNote = new Note(); // reset inputs
    }

    private void EditNote(Note note)
    {
        editingNote = note;
    }

    private async Task UpdateNoteAsync()
    {
        if (editingNote != null)
        {
            DbContext.Notes.Update(editingNote);
            await DbContext.SaveChangesAsync();
            editingNote = null;
        }
    }

    private void CancelEdit()
    {
        editingNote = null;
    }

    private async Task DeleteNoteAsync(Note note)
    {
        DbContext.Notes.Remove(note);
        await DbContext.SaveChangesAsync();
        notes.Remove(note);
    }
}
