@page "/giftideas"

@using System.Collections.Generic
@using Microsoft.AspNetCore.Components.Forms

<h1>Gift Ideas</h1>
<p>Add and manage your gift ideas here.</p>

<div class="d-flex justify-content-end">
    <button class="btn btn-primary mb-3" @onclick="ShowAddGiftIdeaModal">
        <span class="oi oi-plus" aria-hidden="true"></span> Add Gift Idea
    </button>
</div>

@if (showAddGiftIdeaModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(0,0,0,0.5);" @onclick="HideAddGiftIdeaModal">
        <div class="modal-dialog" role="document" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Gift Idea</h5>
                    <button type="button" class="close btn btn-link" @onclick="HideAddGiftIdeaModal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <EditForm Model="newGiftIdea" OnValidSubmit="HandleValidSubmit">
                        <div class="form-group mb-2">
                            <label>Gift Idea</label>
                            <InputText class="form-control" @bind-Value="newGiftIdea.Idea" />
                        </div>
                        <div class="form-group mb-2">
                            <label>For (Person/Occasion)</label>
                            <InputText class="form-control" @bind-Value="newGiftIdea.For" />
                        </div>
                        <button type="submit" class="btn btn-primary">Add</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<ul>
    @foreach (var idea in giftIdeas)
    {
        <li>
            <strong>@idea.Idea</strong> <span class="text-muted">(@idea.For)</span>
            <button class="btn btn-sm btn-danger ms-2" @onclick="() => DeleteGiftIdea(idea)"><span class="oi oi-trash"></span> Delete</button>
        </li>
    }
</ul>

@code {
    private bool showAddGiftIdeaModal = false;
    private List<GiftIdea> giftIdeas = new();
    private GiftIdea newGiftIdea = new GiftIdea();

    private void ShowAddGiftIdeaModal() => showAddGiftIdeaModal = true;
    private void HideAddGiftIdeaModal() => showAddGiftIdeaModal = false;

    private void HandleValidSubmit()
    {
        giftIdeas.Add(newGiftIdea);
        newGiftIdea = new GiftIdea();
        showAddGiftIdeaModal = false;
    }

    private void DeleteGiftIdea(GiftIdea idea)
    {
        giftIdeas.Remove(idea);
    }

    public class GiftIdea
    {
        public string Idea { get; set; } = string.Empty;
        public string For { get; set; } = string.Empty;
    }
}
