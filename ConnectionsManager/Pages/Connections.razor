@page "/connections"
@using ConnectionsManager.Data
@attribute [Authorize]
@inject ApplicationDbContext dbContext
@inject UserManager<IdentityUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

<h1>Connections</h1>

<div class="d-flex justify-content-end">
    <button class="btn btn-primary mb-3" @onclick="ShowAddConnectionModal">
        <span class="oi oi-plus" aria-hidden="true"></span> New Connection
    </button>
</div>

<!-- Connection Cards List -->
<div>
    <h3>Connections List</h3>
    @foreach (var connection in connections)
    {
        <ConnectionCard Connection="connection" />
    }
</div>

@using ConnectionsManager.Shared.ComponentLibrary
@if (showAddConnectionModal)
{
    <AddConnectionModal OnConnectionAdded="AddConnection" OnClose="HideAddConnectionModal" />
}

@code {
    private List<Connection> connections = new();
    private bool showAddConnectionModal = false;
    private async Task AddConnection(Connection connection)
    {
        if (connection != null)
        {
            dbContext.Connections.Add(connection);
            await dbContext.SaveChangesAsync();
            connections.Add(connection); 
        }
        showAddConnectionModal = false;
    }
    private void ShowAddConnectionModal() => showAddConnectionModal = true;
    private void HideAddConnectionModal() => showAddConnectionModal = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userId = UserManager.GetUserId(user);

        connections = await dbContext.Connections
            .Where(c => c.UserId == userId)
            .ToListAsync();
    }
}
