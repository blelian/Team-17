@using ConnectionsManager.Data

<div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(0,0,0,0.5);" @onclick="OnClose">
    <div class="modal-dialog" role="document" @onclick:stopPropagation>
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Connection</h5>
                <button type="button" class="close btn btn-link" @onclick="OnClose" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <EditForm Model="NewConnection" OnValidSubmit="HandleValidSubmit">
                    <div class="form-group mb-2">
                        <label>First Name</label>
                        <InputText class="form-control" @bind-Value="NewConnection.FirstName" />
                    </div>
                    <div class="form-group mb-2">
                        <label>Last Name</label>
                        <InputText class="form-control" @bind-Value="NewConnection.LastName" />
                    </div>
                    <div class="form-group mb-2">
                        <label>Relationship</label>
                        <InputText class="form-control" @bind-Value="NewConnection.Relationship" />
                    </div>
                    <div class="form-group mb-2">
                        <label>Birth Date</label>
                        <InputDate class="form-control" @bind-Value="NewConnection.BirthDate" />
                    </div>
                    <div class="form-group mb-2">
                        <label>Email</label>
                        <InputText class="form-control" @bind-Value="NewConnection.Email" />
                    </div>
                    <div class="form-group mb-2">
                        <label>Phone Number</label>
                        <InputText class="form-control" @bind-Value="NewConnection.Phone" />
                    </div>
                    <div class="form-group mb-2">
                        <label>Address</label>
                        <InputText class="form-control" @bind-Value="NewConnection.Address" />
                    </div>
                    <button type="submit" class="btn btn-primary">Create</button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback<Connection> OnConnectionAdded { get; set; }
    [Parameter]
    public EventCallback OnClose { get; set; }

    private Connection NewConnection = new();

    private async Task HandleValidSubmit()
    {
        await OnConnectionAdded.InvokeAsync(NewConnection);
        NewConnection = new Connection();
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }
}
