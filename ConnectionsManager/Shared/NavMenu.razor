@code {
    private bool collapseNavMenu = true;
    private bool showNotificationsModal = false;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void ShowNotificationsModal()
    {
        showNotificationsModal = true;
    }
    private void HideNotificationsModal()
    {
        showNotificationsModal = false;
    }
}

@if (showNotificationsModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(0,0,0,0.5);" @onclick="HideNotificationsModal">
        <div class="modal-dialog" role="document" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Notifications</h5>
                    <button type="button" class="close btn btn-link" @onclick="HideNotificationsModal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>No Notifications</p>
                </div>
            </div>
        </div>
    </div>
}
